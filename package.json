{
  "name": "wikijs-mcp-server",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Wiki.js integration",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --outfile=dist/bundle.js --external:fsevents --banner:js=\"import{createRequire as __cr}from'module';const require=__cr(import.meta.url);\"",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "wikijs",
    "wiki",
    "documentation"
  ],
  "author": "TRAE AI Agent",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "axios": "^1.6.0",
    "dotenv": "^18.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
