# Wiki.js Configuration
WIKIJS_URL=http://localhost:3000
WIKIJS_API_TOKEN=your_api_token_here

# Alternative: Username/Password authentication
# WIKIJS_USERNAME=your_username
# WIKIJS_PASSWORD=your_password

# MCP Server Configuration
MCP_SERVER_NAME=wikijs-mcp
LOG_LEVEL=info

# Optional: Custom GraphQL endpoint path (default: /graphql)
# WIKIJS_GRAPHQL_PATH=/graphql

# Optional: HTTP request timeout in milliseconds (default: 60000)
# WIKIJS_TIMEOUT_MS=60000

# Optional: Extra HTTP headers sent with every request. Use this for edge/forward-auth
# bypass headers (Cloudflare Access service tokens, Authentik forward-auth basic auth, etc).
#
# Two accepted formats:
#   1. Comma-separated "Header: value" pairs (single line):
#      ADDITIONAL_HEADERS=CF-Access-Client-Id: xxx.access, CF-Access-Client-Secret: yyy, Authorization: Basic base64creds
#   2. JSON object (use this if a value contains commas):
#      ADDITIONAL_HEADERS={"CF-Access-Client-Id":"xxx.access","Authorization":"Basic base64creds"}
#
# NOTE: Wiki.js's own API token is normally sent as `Authorization: Bearer <token>`. If you set
# an `Authorization` header here (e.g. for Authentik basic-auth bypass), the Wiki.js token is
# automatically moved to a side header instead, carrying the full `Bearer <token>` value. In that
# case add a Traefik middleware that renames that side header -> `Authorization` after the
# forward-auth check. The side header defaults to `X-Api-Key`; override with WIKIJS_TOKEN_HEADER.
# ADDITIONAL_HEADERS=

# Optional: header used to carry the Wiki.js Bearer token when `Authorization` is occupied by
# ADDITIONAL_HEADERS (default: X-Api-Key). Must match your Traefik rename middleware's source header.
# WIKIJS_TOKEN_HEADER=X-Api-Key